{
  // The existing Worker in the Cloudflare dashboard. Deploying updates it in place.
  "name": "columbus",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Keep the current URLs exactly as they are:
  //   https://columbus.roksolana-morozova.workers.dev  stays on (production URL)
  //   preview URLs stay off; no custom domains or routes are added.
  "workers_dev": true,
  "preview_urls": false,

  // Static prototype. run_worker_first = every request goes through the Worker,
  // so nothing in ./public is served without a valid session.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Bundle the password screen into the Worker (it is NOT a public file).
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],

  // 5 password attempts per minute per IP address.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]

  // No secrets here. PROTOTYPE_PASSWORD and SESSION_SECRET are uploaded as encrypted
  // Cloudflare secrets by scripts/deploy.sh at deploy time.
}
