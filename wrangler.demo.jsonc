{
  // Public portfolio demo — a SEPARATE Worker from the client deployment.
  //
  // wrangler.jsonc stays untouched: it still deploys the password-protected
  // "columbus" Worker that the client uses for presales. This config only adds
  // an open copy of the same prototype, under a different name, so the two
  // never interfere with each other.
  //
  // Deploy with: npm run deploy:demo
  "name": "columbus-demo",
  "compatibility_date": "2025-09-01",

  // Pinned to the personal Cloudflare account, so this demo can never be
  // deployed to the client's account by accident. An account id is not a
  // secret — it identifies an account, it does not grant access to one.
  "account_id": "a345b00b30f22dbc069ecfba3076b1ea",

  // No "main": there is no Worker script here. The prototype is served as plain
  // static assets, so no password screen, no session cookie, no rate limiter —
  // anyone with the link sees it immediately.
  "assets": {
    "directory": "./public"
  },

  "workers_dev": true,
  "preview_urls": false
}
